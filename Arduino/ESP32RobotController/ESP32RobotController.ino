#include <WiFi.h>
#include <ESPAsyncWebServer.h>
#include <ArduinoJson.h>
#include <Preferences.h>
#include <LittleFS.h>
#include <math.h>
#include <vector>
#include "pins.h"
#include "config.h"
#include "logger.h"

static Config cfg;
static Preferences prefs;
static AsyncWebServer server(80);
static float distanceCm=NAN;
static bool irObstacle=false,motorRunning=false,buzzerOn=false,redOn=false,yellowOn=false,greenOn=false,builtinLedOn=false,sensorFault=false,obstacleStop=false;
static uint32_t lastSample=0,lastStatusLog=0;
static String lastReason="boot";
static std::vector<String> logBuffer;
static uint32_t obstacleCount=0,ultrasonicTimeoutCount=0,motorRunMs=0,lastMotorTick=0;
static uint32_t irLastChange=0,irChangeCount=0;
static bool previousObstacle=false,previousIr=false;
static std::vector<String> events;
static void addEvent(const String& msg){String line=String(millis())+" ms: "+msg;events.push_back(line);if(events.size()>30)events.erase(events.begin());logMessage(LogLevel::INFO,msg);}
static void updateStats(){uint32_t now=millis();if(motorRunning&&lastMotorTick)motorRunMs+=now-lastMotorTick;lastMotorTick=now;}

const char* logLevelName(LogLevel l){switch(l){case LogLevel::ERROR:return "error";case LogLevel::STATUS:return "status";case LogLevel::INFO:return "info";case LogLevel::DEBUG:return "debug";default:return "trace";}}
static LogLevel parseLogLevel(String s){s.toLowerCase();if(s=="error")return LogLevel::ERROR;if(s=="info")return LogLevel::INFO;if(s=="debug")return LogLevel::DEBUG;if(s=="trace")return LogLevel::TRACE;return LogLevel::STATUS;}
void logMessage(LogLevel level,const String& message){if((uint8_t)level>(uint8_t)cfg.logLevel)return;String line="["+String(logLevelName(level))+"] "+message;Serial.println(line);logBuffer.push_back(line);if(logBuffer.size()>40)logBuffer.erase(logBuffer.begin());}
static const char* modeName(RobotMode m){switch(m){case RobotMode::IR:return "ir";case RobotMode::ULTRASONIC:return "ultrasonic";case RobotMode::BOTH:return "both";default:return "constant";}}
static bool parseMode(String s,RobotMode&m){s.toLowerCase();if(s=="ir")m=RobotMode::IR;else if(s=="ultrasonic")m=RobotMode::ULTRASONIC;else if(s=="both")m=RobotMode::BOTH;else if(s=="constant")m=RobotMode::CONSTANT;else return false;return true;}
static void saveConfig(){prefs.begin("robotcfg",false);prefs.putUChar("mode",(uint8_t)cfg.mode);prefs.putUChar("log",(uint8_t)cfg.logLevel);prefs.putBool("irEn",cfg.irEnabled);prefs.putBool("usEn",cfg.ultrasonicEnabled);prefs.putBool("irLow",cfg.irActiveLow);prefs.putBool("motorEn",cfg.motorEnabled);prefs.putBool("buzzEn",cfg.buzzerEnabled);prefs.putBool("ledEn",cfg.ledEnabled);prefs.putBool("builtEn",cfg.builtinLedEnabled);prefs.putBool("buzzStop",cfg.buzzerOnStop);prefs.putUShort("stop",cfg.stopDistance);prefs.putUShort("red",cfg.redLimit);prefs.putUShort("yellow",cfg.yellowLimit);prefs.putUChar("speed",cfg.motorSpeed);prefs.putUShort("interval",cfg.sampleInterval);prefs.putUShort("timeout",cfg.ultrasonicTimeoutMs);prefs.putBool("wifi",cfg.wifiEnabled);prefs.putBool("apEn",cfg.apEnabled);prefs.putBool("staEn",cfg.staEnabled);prefs.putString("apSsid",cfg.apSsid);prefs.putString("apPass",cfg.apPassword);prefs.putString("staSsid",cfg.staSsid);prefs.putString("staPass",cfg.staPassword);prefs.putBool("cors",cfg.corsEnabled);prefs.end();logMessage(LogLevel::STATUS,"Configuration saved to NVS");}
static void loadConfig(){prefs.begin("robotcfg",true);if(prefs.isKey("mode")){cfg.mode=(RobotMode)prefs.getUChar("mode",(uint8_t)cfg.mode);cfg.logLevel=(LogLevel)prefs.getUChar("log",(uint8_t)cfg.logLevel);cfg.irEnabled=prefs.getBool("irEn",cfg.irEnabled);cfg.ultrasonicEnabled=prefs.getBool("usEn",cfg.ultrasonicEnabled);cfg.irActiveLow=prefs.getBool("irLow",cfg.irActiveLow);cfg.motorEnabled=prefs.getBool("motorEn",cfg.motorEnabled);cfg.buzzerEnabled=prefs.getBool("buzzEn",cfg.buzzerEnabled);cfg.ledEnabled=prefs.getBool("ledEn",cfg.ledEnabled);cfg.builtinLedEnabled=prefs.getBool("builtEn",cfg.builtinLedEnabled);cfg.buzzerOnStop=prefs.getBool("buzzStop",cfg.buzzerOnStop);cfg.stopDistance=prefs.getUShort("stop",cfg.stopDistance);cfg.redLimit=prefs.getUShort("red",cfg.redLimit);cfg.yellowLimit=prefs.getUShort("yellow",cfg.yellowLimit);cfg.motorSpeed=prefs.getUChar("speed",cfg.motorSpeed);cfg.sampleInterval=prefs.getUShort("interval",cfg.sampleInterval);cfg.ultrasonicTimeoutMs=prefs.getUShort("timeout",cfg.ultrasonicTimeoutMs);cfg.wifiEnabled=prefs.getBool("wifi",cfg.wifiEnabled);cfg.apEnabled=prefs.getBool("apEn",cfg.apEnabled);cfg.staEnabled=prefs.getBool("staEn",cfg.staEnabled);strlcpy(cfg.apSsid,prefs.getString("apSsid",cfg.apSsid).c_str(),sizeof(cfg.apSsid));strlcpy(cfg.apPassword,prefs.getString("apPass",cfg.apPassword).c_str(),sizeof(cfg.apPassword));strlcpy(cfg.staSsid,prefs.getString("staSsid",cfg.staSsid).c_str(),sizeof(cfg.staSsid));strlcpy(cfg.staPassword,prefs.getString("staPass",cfg.staPassword).c_str(),sizeof(cfg.staPassword));cfg.corsEnabled=prefs.getBool("cors",cfg.corsEnabled);}prefs.end();}
static void resetConfig(){cfg=Config();saveConfig();}
static bool validateConfig(String&e){if(cfg.stopDistance<1||cfg.stopDistance>400)e="stop_distance must be 1..400 cm";else if(cfg.redLimit<1||cfg.redLimit>400)e="red_limit must be 1..400 cm";else if(cfg.yellowLimit<=cfg.redLimit||cfg.yellowLimit>400)e="yellow_limit must be > red_limit and <= 400 cm";else if(cfg.sampleInterval<30||cfg.sampleInterval>5000)e="sample_interval must be 30..5000 ms";else if(cfg.ultrasonicTimeoutMs<5||cfg.ultrasonicTimeoutMs>100)e="ultrasonic_timeout_ms must be 5..100";else if(strlen(cfg.apPassword)>0&&strlen(cfg.apPassword)<8)e="AP password must be empty or at least 8 characters";else return true;return false;}
static void motorStop(const String&why){updateStats();ledcWrite(PIN_MOTOR_ENA,0);digitalWrite(PIN_MOTOR_IN1,LOW);digitalWrite(PIN_MOTOR_IN2,LOW);if(motorRunning){logMessage(LogLevel::STATUS,"Motor stopped: "+why);addEvent("Motor stopped: "+why);}motorRunning=false;lastReason=why;}
static void motorStart(){if(!cfg.motorEnabled||obstacleStop||sensorFault){motorStop("safety interlock");return;}digitalWrite(PIN_MOTOR_IN1,HIGH);digitalWrite(PIN_MOTOR_IN2,LOW);ledcWrite(PIN_MOTOR_ENA,cfg.motorSpeed);if(!motorRunning){logMessage(LogLevel::STATUS,"Motor running");addEvent("Motor started");}motorRunning=true;lastReason="path clear";}
static void setOutputs(){bool oldBuiltin=builtinLedOn;redOn=cfg.ledEnabled&&!isnan(distanceCm)&&distanceCm<=cfg.redLimit;yellowOn=cfg.ledEnabled&&!isnan(distanceCm)&&distanceCm>cfg.redLimit&&distanceCm<=cfg.yellowLimit;greenOn=cfg.ledEnabled&&!isnan(distanceCm)&&distanceCm>cfg.yellowLimit;digitalWrite(PIN_LED_RED,redOn);digitalWrite(PIN_LED_YELLOW,yellowOn);digitalWrite(PIN_LED_GREEN,greenOn);buzzerOn=cfg.buzzerEnabled&&cfg.buzzerOnStop&&obstacleStop;digitalWrite(PIN_BUZZER,buzzerOn);builtinLedOn=cfg.builtinLedEnabled&&obstacleStop;digitalWrite(PIN_BUILTIN_LED,builtinLedOn);if(oldBuiltin!=builtinLedOn)logMessage(LogLevel::DEBUG,String("Built-in LED ")+(builtinLedOn?"ON":"OFF"));}
static void readSensors(){bool irMode=cfg.mode==RobotMode::IR||cfg.mode==RobotMode::BOTH;bool usMode=cfg.mode==RobotMode::ULTRASONIC||cfg.mode==RobotMode::BOTH||cfg.mode==RobotMode::CONSTANT;if(irMode&&cfg.irEnabled){int raw=digitalRead(PIN_IR);irObstacle=cfg.irActiveLow?raw==LOW:raw==HIGH;}else irObstacle=false;sensorFault=false;if(usMode&&cfg.ultrasonicEnabled){digitalWrite(PIN_TRIG,LOW);delayMicroseconds(2);digitalWrite(PIN_TRIG,HIGH);delayMicroseconds(10);digitalWrite(PIN_TRIG,LOW);unsigned long dur=pulseIn(PIN_ECHO,HIGH,(unsigned long)cfg.ultrasonicTimeoutMs*1000UL);if(!dur){distanceCm=NAN;sensorFault=true;ultrasonicTimeoutCount++;}else distanceCm=(float)dur*0.0343f/2.0f;}else distanceCm=NAN;bool irStop=irMode&&cfg.irEnabled&&irObstacle;bool usStop=usMode&&cfg.ultrasonicEnabled&&!isnan(distanceCm)&&distanceCm<=cfg.stopDistance;bool failed=usMode&&cfg.ultrasonicEnabled&&isnan(distanceCm);obstacleStop=irStop||usStop||failed;if(irObstacle!=previousIr){irChangeCount++;previousIr=irObstacle;}if(obstacleStop&&!previousObstacle){obstacleCount++;addEvent("Obstacle detected");}if(!obstacleStop&&previousObstacle)addEvent("Path clear");previousObstacle=obstacleStop;if(irStop)lastReason="IR obstacle";else if(usStop)lastReason="ultrasonic distance limit";else if(failed)lastReason="ultrasonic sensor timeout";if(sensorFault)logMessage(LogLevel::DEBUG,"Ultrasonic timeout; fail-safe stop");logMessage(LogLevel::DEBUG,String("IR=")+(irObstacle?"obstacle":"clear")+" distance="+(isnan(distanceCm)?String("invalid"):String(distanceCm,1))+" cm stop="+(obstacleStop?"yes":"no"));}
static void applyControl(){if(obstacleStop||!cfg.motorEnabled)motorStop(obstacleStop?lastReason:"motor disabled");else motorStart();setOutputs();}
static void addCors(AsyncWebServerResponse*r){if(cfg.corsEnabled){r->addHeader("Access-Control-Allow-Origin","*");r->addHeader("Access-Control-Allow-Methods","GET,POST,PATCH,OPTIONS");r->addHeader("Access-Control-Allow-Headers","Content-Type");}}
static void sendJson(AsyncWebServerRequest*q,JsonDocument&d,int code=200){String out;serializeJson(d,out);auto*r=q->beginResponse(code,"application/json",out);addCors(r);q->send(r);}
static void sendError(AsyncWebServerRequest*q,int code,const String&m){JsonDocument d;d["ok"]=false;d["error"]=m;sendJson(q,d,code);}
static void configJson(JsonObject d){d["mode"]=modeName(cfg.mode);d["log_level"]=logLevelName(cfg.logLevel);d["ir_enabled"]=cfg.irEnabled;d["ultrasonic_enabled"]=cfg.ultrasonicEnabled;d["ir_active_low"]=cfg.irActiveLow;d["motor_enabled"]=cfg.motorEnabled;d["buzzer_enabled"]=cfg.buzzerEnabled;d["led_enabled"]=cfg.ledEnabled;d["builtin_led_enabled"]=cfg.builtinLedEnabled;d["buzzer_on_stop"]=cfg.buzzerOnStop;d["stop_distance"]=cfg.stopDistance;d["red_limit"]=cfg.redLimit;d["yellow_limit"]=cfg.yellowLimit;d["motor_speed"]=cfg.motorSpeed;d["sample_interval"]=cfg.sampleInterval;d["ultrasonic_timeout_ms"]=cfg.ultrasonicTimeoutMs;d["wifi_enabled"]=cfg.wifiEnabled;d["ap_enabled"]=cfg.apEnabled;d["sta_enabled"]=cfg.staEnabled;d["ap_ssid"]=cfg.apSsid;d["sta_ssid"]=cfg.staSsid;d["cors_enabled"]=cfg.corsEnabled;}
static void statusJson(JsonDocument&d){d["online"]=true;d["mode"]=modeName(cfg.mode);d["uptime_ms"]=millis();d["motor"]["running"]=motorRunning;d["motor"]["speed"]=cfg.motorSpeed;d["motor"]["enabled"]=cfg.motorEnabled;d["motor"]["stop_reason"]=obstacleStop?lastReason:"none";d["sensors"]["ir"]["enabled"]=cfg.irEnabled;d["sensors"]["ir"]["obstacle"]=irObstacle;d["sensors"]["ultrasonic"]["enabled"]=cfg.ultrasonicEnabled;if(isnan(distanceCm))d["sensors"]["ultrasonic"]["distance_cm"]=nullptr;else d["sensors"]["ultrasonic"]["distance_cm"]=distanceCm;d["sensors"]["ultrasonic"]["fault"]=sensorFault;d["outputs"]["buzzer"]=buzzerOn;d["outputs"]["red"]=redOn;d["outputs"]["yellow"]=yellowOn;d["outputs"]["green"]=greenOn;d["outputs"]["builtin_led"]=builtinLedOn;}
static void patchConfig(JsonVariantConst v,String&e){if(v["mode"].is<const char*>()){RobotMode m;if(!parseMode(v["mode"].as<String>(),m))e="invalid mode";else cfg.mode=m;}if(v["log_level"].is<const char*>())cfg.logLevel=parseLogLevel(v["log_level"].as<String>());
#define B(k,f) if(v[k].is<bool>())cfg.f=v[k].as<bool>()
B("ir_enabled",irEnabled);B("ultrasonic_enabled",ultrasonicEnabled);B("ir_active_low",irActiveLow);B("motor_enabled",motorEnabled);B("buzzer_enabled",buzzerEnabled);B("led_enabled",ledEnabled);B("builtin_led_enabled",builtinLedEnabled);B("buzzer_on_stop",buzzerOnStop);B("wifi_enabled",wifiEnabled);B("ap_enabled",apEnabled);B("sta_enabled",staEnabled);B("cors_enabled",corsEnabled);
#define N(k,f,maxv) if(v[k].is<int>()){int x=v[k].as<int>();if(x<0||x>maxv)e=String("invalid ")+k;else cfg.f=x;}
N("stop_distance",stopDistance,400);N("red_limit",redLimit,400);N("yellow_limit",yellowLimit,400);N("motor_speed",motorSpeed,255);N("sample_interval",sampleInterval,5000);N("ultrasonic_timeout_ms",ultrasonicTimeoutMs,100);
#undef B
#undef N
if(v["ap_ssid"].is<const char*>())strlcpy(cfg.apSsid,v["ap_ssid"],sizeof(cfg.apSsid));if(v["ap_password"].is<const char*>())strlcpy(cfg.apPassword,v["ap_password"],sizeof(cfg.apPassword));if(v["sta_ssid"].is<const char*>())strlcpy(cfg.staSsid,v["sta_ssid"],sizeof(cfg.staSsid));if(v["sta_password"].is<const char*>())strlcpy(cfg.staPassword,v["sta_password"],sizeof(cfg.staPassword));}
static void setupWifi(){if(!cfg.wifiEnabled){WiFi.mode(WIFI_OFF);return;}WiFi.mode(cfg.apEnabled&&cfg.staEnabled?WIFI_AP_STA:cfg.apEnabled?WIFI_AP:cfg.staEnabled?WIFI_STA:WIFI_OFF);if(cfg.apEnabled){bool ok=strlen(cfg.apPassword)==0?WiFi.softAP(cfg.apSsid):WiFi.softAP(cfg.apSsid,cfg.apPassword);logMessage(ok?LogLevel::STATUS:LogLevel::ERROR,String("AP ")+cfg.apSsid+" IP "+WiFi.softAPIP().toString());}if(cfg.staEnabled&&strlen(cfg.staSsid)){WiFi.begin(cfg.staSsid,cfg.staPassword);logMessage(LogLevel::INFO,"Connecting to station Wi-Fi");}}
static void setupHttp(){server.on("/",HTTP_GET,[](AsyncWebServerRequest*r){r->send(LittleFS,"/index.html","text/html");});
server.on("/api/metrics",HTTP_GET,[](AsyncWebServerRequest*r){updateStats();JsonDocument d;d["obstacle_count"]=obstacleCount;d["ultrasonic_timeouts"]=ultrasonicTimeoutCount;d["ir_transitions"]=irChangeCount;d["motor_runtime_ms"]=motorRunMs;d["uptime_ms"]=millis();d["sensor_fault"]=sensorFault;d["ir_stuck_warning"]=irChangeCount==0&&millis()>60000&&cfg.irEnabled;d["ultrasonic_timeout_rate"]=ultrasonicTimeoutCount;sendJson(r,d);});
server.on("/api/events",HTTP_GET,[](AsyncWebServerRequest*r){JsonDocument d;JsonArray a=d["events"].to<JsonArray>();for(auto&e:events)a.add(e);sendJson(r,d);});
server.on("/api/diagnostics",HTTP_GET,[](AsyncWebServerRequest*r){updateStats();JsonDocument d;JsonObject st=d["status"].to<JsonObject>();statusJson(d["status"].to<JsonDocument>());configJson(d["config"].to<JsonObject>());d["metrics"]["obstacle_count"]=obstacleCount;d["metrics"]["ultrasonic_timeouts"]=ultrasonicTimeoutCount;d["metrics"]["ir_transitions"]=irChangeCount;d["metrics"]["motor_runtime_ms"]=motorRunMs;JsonArray a=d["events"].to<JsonArray>();for(auto&e:events)a.add(e);JsonArray l=d["logs"].to<JsonArray>();for(auto&e:logBuffer)l.add(e);sendJson(r,d);});
server.on("/api/profile",HTTP_POST,[](AsyncWebServerRequest*r){if(!r->hasParam("name",true)){sendError(r,400,"profile name required");return;}String n=r->getParam("name",true)->value();n.toLowerCase();Config old=cfg;if(n=="safe"){cfg.motorSpeed=120;cfg.stopDistance=15;cfg.sampleInterval=80;cfg.mode=RobotMode::BOTH;}else if(n=="normal"){cfg.motorSpeed=180;cfg.stopDistance=10;cfg.sampleInterval=100;cfg.mode=RobotMode::BOTH;}else if(n=="fast"){cfg.motorSpeed=230;cfg.stopDistance=5;cfg.sampleInterval=100;cfg.mode=RobotMode::BOTH;}else{sendError(r,400,"profile must be safe, normal, or fast");return;}String e="";if(!validateConfig(e)){cfg=old;sendError(r,400,e);return;}applyControl();addEvent("Profile selected: "+n);JsonDocument d;d["ok"]=true;configJson(d["config"].to<JsonObject>());sendJson(r,d);});
server.on("/api/status",HTTP_GET,[](AsyncWebServerRequest*r){JsonDocument d;statusJson(d);sendJson(r,d);});server.on("/api/health",HTTP_GET,[](AsyncWebServerRequest*r){JsonDocument d;d["ok"]=!sensorFault;d["uptime_ms"]=millis();d["wifi_ap_ip"]=WiFi.softAPIP().toString();d["wifi_sta_connected"]=WiFi.status()==WL_CONNECTED;d["sensor_fault"]=sensorFault;d["motor_safety_stop"]=obstacleStop;sendJson(r,d,sensorFault?503:200);});server.on("/api/config",HTTP_GET,[](AsyncWebServerRequest*r){JsonDocument d;configJson(d.to<JsonObject>());sendJson(r,d);});server.on("/api/info",HTTP_GET,[](AsyncWebServerRequest*r){JsonDocument d;d["device"]="ESP32 Robot Controller";d["firmware"]="1.0.0";d["chip_model"]=ESP.getChipModel();d["free_heap"]=ESP.getFreeHeap();d["sdk"]=ESP.getSdkVersion();sendJson(r,d);});server.on("/api/logs",HTTP_GET,[](AsyncWebServerRequest*r){JsonDocument d;JsonArray a=d["logs"].to<JsonArray>();for(auto&s:logBuffer)a.add(s);sendJson(r,d);});server.on("/api/config/save",HTTP_POST,[](AsyncWebServerRequest*r){saveConfig();JsonDocument d;d["ok"]=true;sendJson(r,d);});server.on("/api/config/reset",HTTP_POST,[](AsyncWebServerRequest*r){resetConfig();JsonDocument d;d["ok"]=true;sendJson(r,d);});server.on("/api/motor/start",HTTP_POST,[](AsyncWebServerRequest*r){if(obstacleStop||sensorFault){sendError(r,409,"safety interlock active");return;}motorStart();JsonDocument d;d["ok"]=true;sendJson(r,d);});server.on("/api/motor/stop",HTTP_POST,[](AsyncWebServerRequest*r){motorStop("API request");JsonDocument d;d["ok"]=true;sendJson(r,d);});server.on("/api/config",HTTP_PATCH,[](AsyncWebServerRequest*r){},NULL,[](AsyncWebServerRequest*r,uint8_t*data,size_t len,size_t index,size_t total){static String body;if(index==0)body="";body+=(char*)data;if(index+len==total){JsonDocument d;auto e=deserializeJson(d,body);if(e){sendError(r,400,"invalid JSON");body="";return;}Config old=cfg;String err="";patchConfig(d.as<JsonVariantConst>(),err);if(!err.length())validateConfig(err);if(err.length()){cfg=old;sendError(r,400,err);}else{logMessage(LogLevel::STATUS,"Configuration updated via API");applyControl();JsonDocument out;out["ok"]=true;JsonObject config=out["config"].to<JsonObject>();configJson(config);sendJson(r,out);}body="";}});server.onNotFound([](AsyncWebServerRequest*r){if(r->method()==HTTP_OPTIONS){auto*x=r->beginResponse(204);addCors(x);r->send(x);}else sendError(r,404,"not found");});server.begin();logMessage(LogLevel::STATUS,"HTTP server listening on port 80");}
static bool parseBool(String s,bool&b){s.toLowerCase();if(s=="true"||s=="1"||s=="on"){b=true;return true;}if(s=="false"||s=="0"||s=="off"){b=false;return true;}return false;}
static void printHelp(){Serial.println("help | status | health | config show|save|load|reset");Serial.println("mode ir|ultrasonic|both|constant");Serial.println("log level error|status|info|debug|trace");Serial.println("set stop_distance|red_limit|yellow_limit|motor_speed|sample_interval|ir_enabled|ultrasonic_enabled|buzzer_enabled|led_enabled|builtin_led_enabled|motor_enabled|ir_active_low VALUE");Serial.println("motor start|stop | wifi status");}
static void printStatus(){Serial.printf("mode=%s motor=%s speed=%u IR=%s distance=",modeName(cfg.mode),motorRunning?"running":"stopped",cfg.motorSpeed,irObstacle?"obstacle":"clear");if(isnan(distanceCm))Serial.println("invalid");else Serial.printf("%.1fcm\n",distanceCm);Serial.printf("stop=%s reason=%s buzzer=%s builtin_led=%s\n",obstacleStop?"yes":"no",lastReason.c_str(),buzzerOn?"on":"off",builtinLedOn?"on":"off");}
static void command(String line){line.trim();if(!line.length())return;int p=line.indexOf(' ');String cmd=p<0?line:line.substring(0,p),rest=p<0?"":line.substring(p+1);rest.trim();if(cmd=="help")printHelp();else if(cmd=="status")printStatus();else if(cmd=="health")Serial.printf("uptime=%lu heap=%u wifi=%s sensor_fault=%s\n",millis(),ESP.getFreeHeap(),WiFi.isConnected()?"connected":"disconnected",sensorFault?"yes":"no");else if(cmd=="config"){if(rest=="save")saveConfig();else if(rest=="reset")resetConfig();else if(rest=="load"){loadConfig();logMessage(LogLevel::STATUS,"Config loaded");}else Serial.printf("mode=%s log=%s stop=%u red=%u yellow=%u speed=%u\n",modeName(cfg.mode),logLevelName(cfg.logLevel),cfg.stopDistance,cfg.redLimit,cfg.yellowLimit,cfg.motorSpeed);}else if(cmd=="mode"){RobotMode m;if(parseMode(rest,m)){cfg.mode=m;logMessage(LogLevel::STATUS,String("Mode changed to ")+modeName(m));}else Serial.println("Invalid mode");}else if(cmd=="log"&&rest.startsWith("level ")){cfg.logLevel=parseLogLevel(rest.substring(6));logMessage(LogLevel::STATUS,String("Log level set to ")+logLevelName(cfg.logLevel));}else if(cmd=="set"){int q=rest.indexOf(' ');if(q<0){Serial.println("Usage: set key value");return;}String k=rest.substring(0,q),v=rest.substring(q+1);v.trim();bool b;if(k=="log_level")cfg.logLevel=parseLogLevel(v);else if(k=="mode"){RobotMode m;if(!parseMode(v,m)){Serial.println("Invalid mode");return;}cfg.mode=m;}else if(k=="ir_enabled"&&parseBool(v,b))cfg.irEnabled=b;else if(k=="ultrasonic_enabled"&&parseBool(v,b))cfg.ultrasonicEnabled=b;else if(k=="ir_active_low"&&parseBool(v,b))cfg.irActiveLow=b;else if(k=="motor_enabled"&&parseBool(v,b))cfg.motorEnabled=b;else if(k=="buzzer_enabled"&&parseBool(v,b))cfg.buzzerEnabled=b;else if(k=="led_enabled"&&parseBool(v,b))cfg.ledEnabled=b;else if(k=="builtin_led_enabled"&&parseBool(v,b))cfg.builtinLedEnabled=b;else if(k=="buzzer_on_stop"&&parseBool(v,b))cfg.buzzerOnStop=b;else if(k=="stop_distance")cfg.stopDistance=v.toInt();else if(k=="red_limit")cfg.redLimit=v.toInt();else if(k=="yellow_limit")cfg.yellowLimit=v.toInt();else if(k=="motor_speed"){int x=v.toInt();if(x<0||x>255){Serial.println("motor_speed must be 0..255");return;}cfg.motorSpeed=x;}else if(k=="sample_interval")cfg.sampleInterval=v.toInt();else if(k=="ultrasonic_timeout_ms")cfg.ultrasonicTimeoutMs=v.toInt();else{Serial.println("Unknown key or invalid value");return;}String err="";if(!validateConfig(err))Serial.println("Rejected: "+err);else{logMessage(LogLevel::STATUS,"Updated "+k+"="+v);applyControl();}}else if(cmd=="motor"&&rest=="stop")motorStop("CLI request");else if(cmd=="motor"&&rest=="start"){if(obstacleStop||sensorFault)Serial.println("Blocked by safety interlock");else motorStart();}else if(cmd=="wifi")Serial.printf("AP IP=%s STA=%s\n",WiFi.softAPIP().toString().c_str(),WiFi.isConnected()?"connected":"disconnected");else Serial.println("Unknown command. Type help.");}
void setup(){Serial.begin(115200);pinMode(PIN_IR,INPUT);pinMode(PIN_TRIG,OUTPUT);pinMode(PIN_ECHO,INPUT);pinMode(PIN_LED_RED,OUTPUT);pinMode(PIN_LED_YELLOW,OUTPUT);pinMode(PIN_LED_GREEN,OUTPUT);pinMode(PIN_BUZZER,OUTPUT);pinMode(PIN_MOTOR_IN1,OUTPUT);pinMode(PIN_MOTOR_IN2,OUTPUT);pinMode(PIN_BUILTIN_LED,OUTPUT);ledcAttach(PIN_MOTOR_ENA,1000,8);motorStop("boot");if(!LittleFS.begin(true))Serial.println("LittleFS mount failed");loadConfig();String err="";if(!validateConfig(err)){cfg=Config();logMessage(LogLevel::ERROR,"Invalid saved config; defaults used");}logMessage(LogLevel::STATUS,"ESP32 robot booting");setupWifi();setupHttp();printHelp();}
void loop() {
  static String input;
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      command(input);
      input = "";
    } else if (input.length() < 180) {
      input += c;
    }
  }

  uint32_t now = millis();
  if (now - lastSample >= cfg.sampleInterval) {
    lastSample = now;
    readSensors();
    applyControl();
    if (cfg.logLevel == LogLevel::STATUS && now - lastStatusLog > 2000) {
      lastStatusLog = now;
      printStatus();
    }
  }
  delay(1);
}
